theme = "Builtin Dark"
font-family = "Hack Nerd Font"
font-family-bold = "Hack Nerd Font"
font-family-italic = "Hack Nerd Font"
font-family-bold-italic = "Hack Nerd Font"
font-size = 10
font-feature = +liga
# bold-is-bright = true
# launched-from = desktop

# gtk-titlebar = false
# gtk-adwaita = false

mouse-scroll-multiplier = 0.5

# Window settings
window-theme = dark

# Mouse settings
mouse-hide-while-typing = true

# Color scheme (Dracula-inspired dark theme)
# foreground = #f8f8f2
# selection-foreground = #ffffff
# selection-background = #44475a
#cursor-color = #f8f8f2
bold-color = #ffffff

# Unsynced Config
config-file = unsynced
